# The working folder of this repo is the whole home folder: everything is ignored except the configs it keeps, so "stage all" can never pick up private files.
/*
!/.gitignore
!/README.md
!/.gitconfig
!/nixos/
/nixos/result*
!/.config/
/.config/*
!/.config/fish/
!/.config/kitty/
!/.config/starship.toml
!/.config/hypr/
!/.config/mango/
!/.config/quickshell/
!/.config/swiss-desktop/
!/.config/nvim/
!/.config/doom/
!/.config/btop/
!/.config/fastfetch/
!/.config/lazygit/
!/.config/qimgv/
/.config/qimgv/savedState.conf
!/.config/zed/
/.config/zed/*
!/.config/zed/settings.json
!/.config/MangoHud/
!/.config/xdg-desktop-portal-wlr/
!/.config/gtk-3.0/
!/.config/gtk-4.0/
!/.config/mimeapps.list
!/.config/OpenRGB/
!/.config/org.coolercontrol.CoolerControl/
