# Swiss desktop "Measure", Dark Mode: graphite and chalk, not an inverted light mode. Same names and meanings (hex, no #).
# accent_fill is the same red in both modes, the wallpaper posters' own (E93F20; the owner's choice of one red,
# 16 October 2026): marks and fills, 4.8:1 on background. "accent" (and error) is the same hue a little brighter, for
# red text on dark surfaces (5.3:1 on surface, 4.6:1 on surface2).
mode=dark
color_scheme=prefer-dark
gtk_theme=adw-gtk3-dark
icon_theme=Papirus-Dark
# Desktop picture, relative to $HOME (sources in ~/Pictures/Wallpapers/SOURCES.txt).
wallpaper=Pictures/Wallpapers/swiss-typography/dont-wish-for-it-work-for-it-black.png

background=0D0D0D
surface=161616
surface2=222222
elevated=222222
text=F2F2EE
text2=A8A8A2
muted=8E8E87
border=333333
border_strong=6E6E69
accent=EC5A40
accent_fill=E93F20
accent_fg=0D0D0D
selection=521F16
# GTK dimmed text (subtitles, .dim-label): opacity of the text colour, in percent; GTK's own 55 % (5.6:1 here).
dim_opacity=55
success=3DBE7A
warning=E0A030
error=EC5A40
info=6FA8E8

ansi0=262624
ansi1=F05A4A
ansi2=5BBF7A
ansi3=E0A43A
ansi4=6FA8E8
ansi5=C58AD6
ansi6=4FC1C9
ansi7=A8A59E
ansi8=858585
ansi9=FF6B6B
ansi10=7ED69A
ansi11=F2C063
ansi12=94C0F2
ansi13=D8A8E6
ansi14=7FD6DC
ansi15=ECEAE4
