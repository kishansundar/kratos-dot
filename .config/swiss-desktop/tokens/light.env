# Swiss desktop "Measure", Light Mode: warm paper and ink. One red, for marks meaning "now / here" (hex, no #).
# Contrast ratios are checked by tests/contrast.sh.
# The red is the wallpaper posters' own (E93F20), the owner's choice of one red (16 October 2026): accent_fill for marks
# and fills (3.7:1 here, enough for marks). Red text (accent, error) is the same hue darkened to 5.2:1; text on a red
# fill is ink, since white on this red is only 4.0:1.
mode=light
color_scheme=prefer-light
gtk_theme=adw-gtk3
icon_theme=Papirus-Light
# Desktop picture, relative to $HOME (sources in ~/Pictures/Wallpapers/SOURCES.txt).
wallpaper=Pictures/Wallpapers/swiss-typography/just-because-its-hard-doesnt-mean-its-impossible-grey.png

background=F4F4F1
surface=FFFFFF
surface2=E6E6E1
elevated=FFFFFF
text=111111
text2=55554F
muted=66665F
border=CDCDC7
border_strong=83837C
accent=C02E13
accent_fill=E93F20
accent_fg=111111
selection=F2D4CE
# GTK dimmed text (subtitles, .dim-label): opacity of the text colour, in percent. GTK's own 55 % gives about 4:1 on
# this paper; 60 % gives 4.6-4.9:1 (audit DS-04).
dim_opacity=60
success=1A7A4A
warning=9A5B00
error=C02E13
info=1D5AA0

ansi0=161514
ansi1=C4161C
ansi2=1C7337
ansi3=8A5700
ansi4=1D5AA0
ansi5=8A3A88
ansi6=0E6A73
# white (7) is a light ground, the surface2 grey: programs print white text on their coloured grounds (ls setuid and
# sticky entries, fish's search match on bright black, FAIL badges); it reads 4.6-5.5:1 on colours 1-6 and on 8. As
# text on paper it is nearly invisible (1.1:1), as in most light themes, so terminal configs use 8 for a quiet grey.
# (It was 595650, a dark grey: white on those grounds read 1.05-1.3:1. Kitty audit, 18 October 2026.)
ansi7=E6E6E1
ansi8=666666
ansi9=A01218
ansi10=155C2B
ansi11=6E4500
ansi12=17487F
ansi13=6E2E6C
ansi14=0A5459
ansi15=000000
