# name: 'Swiss'
# Swiss desktop: fish's own default theme in the 16 terminal colours, so it follows kitty's Light and Dark palettes,
# with three changes from the kitty audit (18 October 2026):
#   search match and selection: the terminal's selection ground (the selection token) under normal text, instead of
#     white on bright black (1.3:1 on paper, 1.5:1 on graphite);
#   pager progress: quiet grey text, instead of bright white on cyan (3.3:1 / 1.8:1);
#   comments: quiet grey, instead of red beside the bright-red errors (7 CIEDE2000 apart: a comment read as an error).
# fish picks the variant from the terminal's reported background (fish_terminal_color_theme). Generated by
# swiss-build from tokens/{light,dark}.env; do not edit here.

[light]
# preferred_background: @light.background@
fish_color_autosuggestion brblack
fish_color_cancel -r
fish_color_command normal
fish_color_comment brblack
fish_color_cwd green
fish_color_cwd_root red
fish_color_end green
fish_color_error brred
fish_color_escape brcyan
fish_color_history_current --bold
fish_color_host normal
fish_color_host_remote yellow
fish_color_normal normal
fish_color_operator brcyan
fish_color_param cyan
fish_color_quote yellow
fish_color_redirection cyan --bold
fish_color_search_match --background=@light.selection@ --bold
fish_color_selection --background=@light.selection@ --bold
fish_color_status red
fish_color_user brgreen
fish_color_valid_path --underline
fish_pager_color_description yellow --italics
fish_pager_color_prefix --bold --underline
fish_pager_color_progress brblack
fish_pager_color_selected_background -r

[dark]
# preferred_background: @dark.background@
fish_color_autosuggestion brblack
fish_color_cancel -r
fish_color_command normal
fish_color_comment brblack
fish_color_cwd green
fish_color_cwd_root red
fish_color_end green
fish_color_error brred
fish_color_escape brcyan
fish_color_history_current --bold
fish_color_host normal
fish_color_host_remote yellow
fish_color_normal normal
fish_color_operator brcyan
fish_color_param cyan
fish_color_quote yellow
fish_color_redirection cyan --bold
fish_color_search_match --background=@dark.selection@ --bold
fish_color_selection --background=@dark.selection@ --bold
fish_color_status red
fish_color_user brgreen
fish_color_valid_path --underline
fish_pager_color_description yellow --italics
fish_pager_color_prefix --bold --underline
fish_pager_color_progress brblack
fish_pager_color_selected_background -r

[unknown]
fish_color_autosuggestion brblack
fish_color_cancel -r
fish_color_command normal
fish_color_comment brblack
fish_color_cwd green
fish_color_cwd_root red
fish_color_end green
fish_color_error brred
fish_color_escape brcyan
fish_color_history_current --bold
fish_color_host normal
fish_color_host_remote yellow
fish_color_normal normal
fish_color_operator brcyan
fish_color_param cyan
fish_color_quote yellow
fish_color_redirection cyan --bold
fish_color_search_match --reverse --bold
fish_color_selection --reverse --bold
fish_color_status red
fish_color_user brgreen
fish_color_valid_path --underline
fish_pager_color_description yellow --italics
fish_pager_color_prefix --bold --underline
fish_pager_color_progress brblack
fish_pager_color_selected_background -r
