;;; doom-swiss-@mode@-theme.el --- Swiss desktop, @mode@ -*- lexical-binding: t; no-byte-compile: t; -*-
;;
;; Generated by swiss-build from tokens/@mode@.env; do not edit here. Linked as
;; ~/.config/doom/themes/doom-swiss-@mode@-theme.el. Ink on paper: keywords in bold ink, comments faint italic, the
;; terminal palette for strings, numbers and types, and the one red only where something is "here" (the cursor, the
;; current line number, the current match) or wrong. Square and flat: no boxes, 1 px rules in the hairline colour.
;;
;;; Code:

(require 'doom-themes)

(def-doom-theme doom-swiss-@mode@
  "The Swiss desktop's @mode@ mode, from its tokens."
  :family 'doom-swiss
  :background-mode '@mode@

  ;; name        GUI              256              16
  ((bg         '("#@background@" "#@background@" "#@background@"))
   (fg         '("#@text@"       "#@text@"       "#@text@"))
   (bg-alt     '("#@surface@"    "#@surface@"    "#@surface@"))
   (fg-alt     '("#@text2@"      "#@text2@"      "#@text2@"))

   (base0      '("#@surface@"       "#@surface@"       "#@surface@"))
   (base1      '("#@surface2@"      "#@surface2@"      "#@surface2@"))
   (base2      '("#@border@"        "#@border@"        "#@border@"))
   (base3      '("#@border@"        "#@border@"        "#@border@"))
   (base4      '("#@muted@"         "#@muted@"         "#@muted@"))
   (base5      '("#@text2@"         "#@text2@"         "#@text2@"))
   (base6      '("#@text2@"         "#@text2@"         "#@text2@"))
   (base7      '("#@text@"          "#@text@"          "#@text@"))
   (base8      '("#@text@"          "#@text@"          "#@text@"))

   (grey       base4)
   (red        '("#@accent@"  "#@accent@"  "#@accent@"))
   (orange     '("#@warning@" "#@warning@" "#@warning@"))
   (green      '("#@ansi2@"   "#@ansi2@"   "#@ansi2@"))
   (teal       '("#@ansi6@"   "#@ansi6@"   "#@ansi6@"))
   (yellow     '("#@ansi3@"   "#@ansi3@"   "#@ansi3@"))
   (blue       '("#@ansi4@"   "#@ansi4@"   "#@ansi4@"))
   (dark-blue  '("#@ansi12@"  "#@ansi12@"  "#@ansi12@"))
   (magenta    '("#@ansi5@"   "#@ansi5@"   "#@ansi5@"))
   (violet     '("#@ansi13@"  "#@ansi13@"  "#@ansi13@"))
   (cyan       '("#@ansi6@"   "#@ansi6@"   "#@ansi6@"))
   (dark-cyan  '("#@ansi14@"  "#@ansi14@"  "#@ansi14@"))

   ;; The one red, as a mark (cursor, current line number, current match) and the ink on it.
   (accent-fill '("#@accent_fill@" "#@accent_fill@" "#@accent_fill@"))
   (accent-fg   '("#@accent_fg@"   "#@accent_fg@"   "#@accent_fg@"))
   (hairline    '("#@border@"      "#@border@"      "#@border@"))
   (sel         '("#@selection@"   "#@selection@"   "#@selection@"))

   ;; Doom's universal syntax classes
   (highlight      fg)
   (vertical-bar   hairline)
   (selection      sel)
   (builtin        magenta)
   (comments       base4)
   (doc-comments   fg-alt)
   (constants      blue)
   (functions      fg)
   (keywords       fg)
   (methods        fg)
   (operators      fg-alt)
   (type           cyan)
   (strings        green)
   (variables      fg)
   (numbers        blue)
   (region         sel)
   (error          red)
   (warning        orange)
   (success        '("#@success@" "#@success@" "#@success@"))
   (vc-modified    orange)
   (vc-added       success)
   (vc-deleted     red))

  ;;;; Face overrides
  (((font-lock-keyword-face &override) :weight 'bold)
   ((font-lock-comment-face &override) :slant 'italic)
   ((font-lock-doc-face &override) :slant 'italic)
   (cursor :background accent-fill)
   ((line-number &override) :foreground base4)
   ((line-number-current-line &override) :foreground accent-fill :weight 'bold)
   (isearch :background accent-fill :foreground accent-fg :weight 'bold)
   (lazy-highlight :background sel :foreground fg)
   (show-paren-match :background base1 :foreground fg :weight 'bold)
   (hl-line :background base1)
   (link :foreground blue :underline t)
   (mode-line :background bg :foreground fg :box nil :overline hairline)
   (mode-line-inactive :background bg :foreground base4 :box nil :overline hairline)
   (mode-line-emphasis :foreground fg :weight 'bold)
   (header-line :background bg :foreground fg :box nil)
   (minibuffer-prompt :foreground fg :weight 'bold)
   (vertical-border :foreground hairline)
   (fringe :background bg :foreground base4)
   ;;;; doom-modeline
   (doom-modeline-bar :background bg)
   (doom-modeline-bar-inactive :background bg)
   (doom-modeline-buffer-modified :foreground accent-fill :weight 'bold)
   ;;;; doom-dashboard
   (doom-dashboard-banner :foreground fg)
   (doom-dashboard-menu-title :foreground fg)
   (doom-dashboard-menu-desc :foreground fg-alt)
   ;;;; vertico / completion
   (vertico-current :background base1 :weight 'bold)
   (completions-common-part :foreground fg :weight 'bold)
   (orderless-match-face-0 :foreground fg :weight 'bold :underline t))

  ;;;; Variable overrides
  ())

;;; doom-swiss-@mode@-theme.el ends here
