# Swiss desktop (@mode@): btop colours. Generated by swiss-build; btop reads it at start.
# Graphs are neutral and turn red only at the top of their range.
theme[main_bg]="#@background@"
theme[main_fg]="#@text@"
theme[title]="#@text@"
theme[hi_fg]="#@accent@"
theme[selected_bg]="#@accent_fill@"
theme[selected_fg]="#@accent_fg@"
theme[inactive_fg]="#@muted@"
theme[graph_text]="#@text2@"
theme[meter_bg]="#@surface2@"
theme[proc_misc]="#@text2@"
theme[cpu_box]="#@border_strong@"
theme[mem_box]="#@border_strong@"
theme[net_box]="#@border_strong@"
theme[proc_box]="#@border_strong@"
theme[div_line]="#@border@"
theme[temp_start]="#@text2@"
theme[temp_mid]="#@warning@"
theme[temp_end]="#@accent@"
theme[cpu_start]="#@text2@"
theme[cpu_mid]="#@text@"
theme[cpu_end]="#@accent@"
theme[free_start]="#@text2@"
theme[free_mid]="#@text2@"
theme[free_end]="#@text@"
theme[cached_start]="#@text2@"
theme[cached_mid]="#@text2@"
theme[cached_end]="#@text@"
theme[available_start]="#@text2@"
theme[available_mid]="#@text2@"
theme[available_end]="#@text@"
theme[used_start]="#@text2@"
theme[used_mid]="#@text@"
theme[used_end]="#@accent@"
theme[download_start]="#@text2@"
theme[download_mid]="#@text@"
theme[download_end]="#@accent@"
theme[upload_start]="#@text2@"
theme[upload_mid]="#@text@"
theme[upload_end]="#@accent@"
theme[process_start]="#@text2@"
theme[process_mid]="#@text@"
theme[process_end]="#@accent@"
