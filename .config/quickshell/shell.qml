//@ pragma UseQApplication
import QtQuick
import Quickshell
import Quickshell.Io
import qs
import qs.bar
import qs.overlays
import qs.services
import qs.dashboard   // the dashboard overlay (dashboard/Dashboard.qml) and its parts

// Swiss desktop shell for mango, one long-running process: background, bar, popups, launcher, notifications,
// dock, OSDs and the admin password prompt. Started by ~/.config/mango/autostart.sh through scripts/run-shell.sh
// (which restarts it after a crash). This file only assembles the windows and answers `qs ipc call bar <name>`.
//
//   Theme.qml    every token: colours (from ~/.config/swiss-desktop), type, space, sizes, motion; the shell's folders
//   Glyphs.qml   the icon font's codepoints by name (generated by design/glyphs/build.py)
//   bar/         the bar and its modules (folio, clock, day ruler, status icons, tray drawer, Now Playing)
//   panels/      the popovers PanelHost loads by name when they open (launcher, calendar, sound, network, ...)
//   dashboard/   the dashboard's sections (its card is panels/DashboardPanel) and its `dash` IPC
//   overlays/    the shell's own windows: wallpaper, popover host, dock, toasts, OSD, picker, polkit
//   components/  the shared pieces everything is drawn with (text styles, icons, rows, rulers, sliders, fields)
//   services/    the system behind them, one singleton each (mango, audio, network, Bluetooth, notifications, ...);
//                every change to the machine goes through one of these, and the panels only read them
//   scripts/     helpers run by the services and by mango, kitty and Claude Code (see each file's header)
//   assets/      icons and fonts the shell loads; design/ holds the design packages (references, not loaded)
//   tests/       sh tests/run.sh (JS logic), sh tests/lint.sh (qmllint); CLAUDE.md: notes for agents
ShellRoot {
    Variants {
        model: Quickshell.screens
        Background {}
    }
    Variants {
        model: Quickshell.screens
        Bar {}
    }

    PanelHost {}
    // The Bluetooth pairing agent runs from the start (so a device can ask at any time); its request opens the popover.
    Connections {
        target: BtAgent
        function onRequested() { if (Panels.current !== "bluetooth") Panels.open("bluetooth") }
    }
    WallpaperPicker {}
    Dashboard {}           // the dashboard popover's `qs ipc call dash toggle` and its sampling (panels/DashboardPanel)
    // Night light keeps its state in Prefs; a singleton exists only once something asks for it, so ask at start: a
    // night light left on comes back with the shell.
    // Busy (the bar's busy mark) likewise: its `qs ipc call busy ...` must answer from the start.
    Component.onCompleted: { NightLight.on; Busy.status; }
    Toasts {}
    Osd {}
    Polkit {}
    // The dock (design/dock): one per screen, hidden until the pointer presses on the screen's bottom edge.
    Variants {
        model: Quickshell.screens
        Dock {}
    }
    IpcHandler {
        target: "dock"
        function focus(): void { Panels.dockFocusRequested() }          // the dock takes the keyboard: arrows, Enter, Esc
    }

    // Keys (mango's bind.conf calls these as `qs ipc call bar <name>`).
    IpcHandler {
        target: "bar"
        function launcher(): void { Panels.toggle("launcher") }          // Super+Space
        function dashboard(): void { Panels.toggle("dashboard") }        // Super+D
        function claude(): void { Panels.toggle("claude") }              // Super+Ctrl+K
        function media(): void { Panels.toggle("media") }                // Super+Ctrl+M
        function tray(): void { Panels.trayOpen = !Panels.trayOpen }     // Super+Ctrl+T: the drawer
        function wallpaper(): void { Panels.toggle("wallpaper") }        // Super+W
        function mode(): void { Theme.toggleMode() }                     // (Super+Shift+T runs swiss-mode itself)
        function clipboard(): void { Panels.toggle("clipboard") }        // Super+V
        function power(): void { Panels.toggle("power") }                // Super+Esc
        function calendar(): void { Panels.toggle("calendar") }          // Super+Ctrl+C
        function audio(): void { Panels.toggle("audio") }                // Super+Ctrl+A
        function display(): void { Panels.toggle("display") }            // (the bar's sun opens it directly)
        function brightnessUp(): void { Brightness.step(1) }             // XF86MonBrightnessUp (mango bind.conf)
        function brightnessDown(): void { Brightness.step(-1) }          // XF86MonBrightnessDown
        function network(): void { Panels.toggle("network") }            // Super+Ctrl+W
        function bluetooth(): void { Panels.toggle("bluetooth") }        // Super+Ctrl+B
        function notifications(): void { Panels.toggle("notifications") } // Ctrl+Alt+\
        function clear(): void { Notifs.clearAll() }                      // Ctrl+Alt+Backspace
        function dnd(): void { Notifs.setDnd(!Prefs.dnd) }
        function night(): void { NightLight.toggle() }                    // Super+Alt+N
        function caffeine(): void { Caffeine.toggle() }                   // Super+Alt+C
        function osd(): void { Audio.changedByUser() }                     // show the volume pop-up (for testing)
        // The media keys (mango bind.conf) act on the player the bar shows (Media.player), not playerctl's own pick,
        // which can be another (a paused tab while Spotify plays).
        function playPause(): void { if (Media.player?.canTogglePlaying) Media.player.togglePlaying() }   // XF86AudioPlay / Pause
        function next(): void { if (Media.player?.canGoNext) Media.player.next() }                       // XF86AudioNext
        function previous(): void { if (Media.player?.canGoPrevious) Media.player.previous() }           // XF86AudioPrev
        // That player, one field a line (Media.nowPlaying; the lock screen reads the same lines from a file). Read only.
        function nowPlaying(): string { return Media.nowPlaying }
        function reload(): void { Quickshell.reload(true) }               // Super+Shift+R
    }
}
