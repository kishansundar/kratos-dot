import QtQuick
import QtQuick.Effects
import Quickshell
import Quickshell.Widgets

// An app icon painted in one colour.
// The Swiss icon theme is single-colour, so this paints its shape in `color` and keeps the edges smooth.
// Icons the theme doesn't draw (a new app, say) are shown as they are, in full colour, never as a silhouette.
Item {
    id: root

    property string icon: ""          // icon name, e.g. "kitty", "org.gnome.Nautilus"
    property int size: 48             // 48 dock · 24 launcher · 16 tray
    property color color: Theme.text  // the launcher's selected row passes Theme.bg

    implicitWidth: root.size
    implicitHeight: root.size

    // Names the Swiss theme draws. Generated by build.py; keep in step with the theme.
    readonly property var swiss: ["1password", "btop", "emacs", "helium", "kitty", "mpv", "nix-snowflake", "nvidia-settings", "nvim", "obsidian", "org.coolercontrol.CoolerControl", "org.freedesktop.Piper", "org.gnome.Nautilus", "org.openrgb.OpenRGB", "org.pulseaudio.pavucontrol", "polychromatic", "preferences-system-network", "qimgv", "rustdesk", "spotify-client", "steam", "user-trash", "user-trash-full", "yazi", "zed", "zen"]
    readonly property bool painted: root.swiss.indexOf(root.icon) >= 0

    IconImage {
        id: shape
        anchors.fill: parent
        implicitSize: root.size
        source: Quickshell.iconPath(root.icon, "application-x-executable")
        visible: !root.painted
        layer.enabled: root.painted
    }

    Rectangle {
        visible: root.painted
        anchors.fill: parent
        color: root.color
        layer.enabled: root.painted
        layer.effect: MultiEffect {
            maskEnabled: true
            maskSource: shape
            maskThresholdMin: 0.5   // with spread 1.0 the mask keeps the icon's anti-aliasing;
            maskSpreadAtMin: 1.0    // the defaults cut it to hard pixel edges
        }
    }
}
