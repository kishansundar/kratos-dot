[Icon Theme]
Name=Swiss
Comment=Swiss pictograms for app icons. Single colour; the shell paints them in its text colour.
# Put your current icon theme first so every icon this theme doesn't draw still resolves.
Inherits=hicolor
Directories=16x16/apps,16x16/places,16x16/status,scalable/apps,scalable/places,scalable/status

[16x16/apps]
Size=16
Context=Applications
Type=Fixed

[16x16/places]
Size=16
Context=Places
Type=Fixed

[16x16/status]
Size=16
Context=Status
Type=Fixed

[scalable/apps]
Size=48
MinSize=17
MaxSize=512
Context=Applications
Type=Scalable

[scalable/places]
Size=48
MinSize=17
MaxSize=512
Context=Places
Type=Scalable

[scalable/status]
Size=48
MinSize=17
MaxSize=512
Context=Status
Type=Scalable
