// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },
  // The Swiss desktop's type and colours (themes/swiss.json is generated by ~/.config/swiss-desktop and linked here);
  // "system" follows the desktop's light / dark mode.
  "ui_font_family": "Geist",
  "ui_font_size": 16,
  "buffer_font_family": "Geist Mono",
  "buffer_font_size": 15,
  "terminal": {
    "font_family": "Geist Mono",
  },
  "theme": {
    "mode": "system",
    "light": "Swiss Light",
    "dark": "Swiss Dark",
  },
}
