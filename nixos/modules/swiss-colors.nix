# Swiss desktop colours for NixOS: the boot menu (Limine) and the text console (boot messages, the ly login screen,
# Ctrl+Alt+F2), which are always in Dark Mode. Generated by ~/.config/swiss-desktop/bin/swiss-build from
# tokens/dark.env and copied to ~/nixos/modules/swiss-colors.nix: edit the tokens and run swiss-build (then nrs), never
# this file. Hex without "#".
{
  background = "0D0D0D";
  text = "F2F2EE";
  muted = "A8A8A2";  # secondary text (textMuted)
  rule = "6E6E69";  # rulers and ticks
  accent = "EC5A40";  # the one red

  # The sixteen terminal colours, as kitty's, except slot 0: on the console it is also the ground, so the background.
  ansi = [
    "0D0D0D" "F05A4A" "5BBF7A" "E0A43A" "6FA8E8" "C58AD6" "4FC1C9" "A8A59E"
    "858585" "FF6B6B" "7ED69A" "F2C063" "94C0F2" "D8A8E6" "7FD6DC" "ECEAE4"
  ];
}
